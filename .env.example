# ─────────────────────────────────────────────────────────────
# Selora — Supabase backend
# ─────────────────────────────────────────────────────────────
# Copy to `.env` (gitignored). Restart `npm run dev` after changing.
#
# Dashboard → Project Settings → API:
#   VITE_SUPABASE_URL      = Project URL, or just the project ref
#   VITE_SUPABASE_ANON_KEY = publishable key (sb_publishable_…)
#                            or the legacy anon JWT (eyJ…)
# Never put the service_role / sb_secret key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
